# HonchoBench environment variables.
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Keys are NEVER baked into the image; `docker compose run` loads this file via
# `env_file`. Precedence inside the runner: explicit --env-file > .env > environment.
# Nothing is required for the container to build or show --help; a key is only
# needed when you actually run a bench.

# ---- OpenAI-compatible endpoint (default target: the self-hosted Plexus gateway)
# The benchmark's default chat model routes here via the 'openai' transport.
PLEXUS_API_KEY=                            # <placeholder> fill with your Plexus key
PLEXUS_BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
# Alternative: talk to OpenAI directly (unset PLEXUS_ above and use these):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---- Default exemplar models documented for the Plexus gateway
HONCHOBENCH_MODELS=LiquidAI/LFM2_5-2_6B    # default chat model (comma list OK)
# nomic-ai/nomic-embed-text-v1.5 is the recommended embedding model for the
# gateway's embedding router. The standalone harness itself makes no embedding
# calls, so this is a deployment note, not a runtime dependency here.

# ---- Optional native transports (only used when a model is prefixed anthropic/ or gemini/)
# Example:  --models anthropic/claude-3-5-sonnet  or  gemini/gemini-2.0-flash
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Runtime knobs (optional)
# HONCHOBENCH_MODELS=gpt-4o,gpt-4o-mini
# --limit (CLI) smoke-tests the first N conversations, e.g.:
#   make bench MODELS=LiquidAI/LFM2_5-2_6B LIMIT=1
