# HonchoBench runtime env for the SUPPORTED way (real honcho @ commit 4448979).
# Copy to _vendor/honcho/.env — created automatically by scripts/setup_db.sh.
#
# The API key is NOT stored here. It is read from the process env var named by
# each *_MODEL_CONFIG__OVERRIDES__API_KEY_ENV below (PLEXUS_API_KEY), which
# start_honcho.sh exports from the git-ignored .bench_plexus_key file.
# NEVER hardcode a key value in this file or any tracked file.

# --- database / cache ---
DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@localhost:5433/postgres
CACHE_ENABLED=false

# --- embeddings: nomic-embed-text-v1.5 @ 768 dims ---
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY
EMBEDDING_VECTOR_DIMENSIONS=768

# --- deriver scheduling (flush immediately, no batching gate) ---
DERIVER_FLUSH_ENABLED=true
DERIVER_REPRESENTATION_BATCH_WORK_UNIT_TARGET_TOKENS=0
DERIVER_REPRESENTATION_BATCH_MAX_AGE_SECONDS=0

# --- PITFALL: honcho does NOT inherit top-level MODEL_CONFIG__* into per-role
#     configs. Every role defaults to gpt-5.4-mini @ api.openai.com (401 without
#     a key). Set EACH role explicitly. Swap __MODEL to benchmark another model. ---

# default (used by roles without a dedicated override below)
MODEL_CONFIG__TRANSPORT=openai
MODEL_CONFIG__MODEL=ModelA
MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=ModelA
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=4096

SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=ModelA
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
SUMMARY_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=ModelA
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=ModelA
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=ModelA
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=ModelA
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY

DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=ModelA
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://plexus.nebulosa-bass.ts.net/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=PLEXUS_API_KEY
